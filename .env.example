# ClipForge AI configuration. Copy to .env and edit. Everything has a working default except where noted.

# --- core ---------------------------------------------------------------
SECRET_KEY=                      # leave empty to auto-generate one in the data folder
ALLOW_SIGNUP=true                # set false after creating your account (first account can always sign up)
COOKIE_SECURE=false              # set true when served over https
CLIPFORGE_DATA_DIR=./data        # uploads, caches, rendered clips, sqlite db
DATABASE_URL=                    # empty = SQLite in the data folder. Postgres: postgresql+psycopg2://user:pass@host/db

# --- worker -------------------------------------------------------------
EMBEDDED_WORKER=true             # true: API process also runs jobs. false: run `python -m app.worker` separately
JOB_MAX_ATTEMPTS=2
FFMPEG_THREADS=0                 # 0 = let ffmpeg decide
RENDER_QUALITY=standard          # draft | standard | high
PROXY_HEIGHT=480

# --- speech-to-text -----------------------------------------------------
TRANSCRIBE_PROVIDER=auto         # auto | faster_whisper | sherpa_onnx | openai | none
WHISPER_MODEL=base.en            # faster-whisper model: tiny.en, base.en, small.en, medium.en ... (bigger = slower, better)
SHERPA_MODEL_DIR=                # optional: folder with a sherpa-onnx whisper model
OPENAI_API_KEY=                  # only needed for TRANSCRIBE_PROVIDER=openai (~$0.006 per audio minute)
OPENAI_TRANSCRIBE_MODEL=whisper-1

# --- LLM re-ranking (optional; any OpenAI-compatible chat endpoint) ----------
LLM_API_KEY=                     # empty = signal scoring only (free)
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_PRICE_IN_PER_M=0.15          # used only for the cost display
LLM_PRICE_OUT_PER_M=0.60

# --- storage for rendered clips (optional) ----------------------------------
STORAGE_BACKEND=local            # local | s3
S3_ENDPOINT=                     # e.g. https://<account>.r2.cloudflarestorage.com
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
